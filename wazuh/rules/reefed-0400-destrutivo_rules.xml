    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*(?:create(?:\s+or\s+replace)?(?!\s+(?:temp|temporary)\b)|alter|drop(?!\s+(?:temp|temporary)\b)|rename|comment\s+on)\s+\w</field>
    <description>Reefed: DDL (mudança de estrutura) enviado por $(dstuser) (origem $(db.client)).</description>
