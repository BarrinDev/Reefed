<!--
  Reefed - comandos destrutivos e DDL (IDs 110400-110449)

  DROP, TRUNCATE, DELETE/UPDATE sem WHERE e alterações de estrutura. Valem para
  PostgreSQL, MySQL e MariaDB (grupo reefed_query).

  O nível sobe quando quem executa não está na lista de administradores
  (etc/lists/reefed/db-admins). Fora do horário comercial o nível sobe de novo
  (regras 110904 e 110905, no arquivo de horário).

  "Enviado" e não "executado": o PostgreSQL registra o comando antes de rodar. O
  resultado aparece em seguida (linha ERROR no PostgreSQL, db.errno no MySQL e
  db.retcode no MariaDB).
-->

<group name="reefed,database,">

  <rule id="110400" level="12">
    <if_group>reefed_query</if_group>
    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*drop\s+(?:database|schema)\b</field>
    <description>Reefed: DROP DATABASE/SCHEMA enviado por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>reefed_destructive,pci_dss_10.2.7,gdpr_IV_32.2,hipaa_164.312.c.1,nist_800_53_AU.14,nist_800_53_SI.7,tsc_CC6.1,tsc_CC7.2,tsc_A1.2,</group>
  </rule>

  <rule id="110401" level="8">
    <if_group>reefed_query</if_group>
    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*drop\s+table\b</field>
    <description>Reefed: DROP TABLE enviado por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>reefed_destructive,pci_dss_10.2.7,gdpr_IV_32.2,hipaa_164.312.c.1,nist_800_53_AU.14,nist_800_53_SI.7,tsc_CC6.1,tsc_CC7.2,tsc_A1.2,</group>
  </rule>

  <rule id="110402" level="8">
    <if_group>reefed_query</if_group>
    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*truncate\b(?!\s*\()</field>
    <description>Reefed: TRUNCATE enviado por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>reefed_destructive,pci_dss_10.2.7,gdpr_IV_32.2,hipaa_164.312.c.1,nist_800_53_AU.14,nist_800_53_SI.7,tsc_CC6.1,tsc_CC7.2,tsc_A1.2,</group>
  </rule>

  <!-- DELETE sem WHERE (ou com WHERE 1=1 / true) -->
  <rule id="110403" level="9">
    <if_group>reefed_query</if_group>
    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*delete\s+from\s+[\w."`\[\]]+(?:\s+(?:as\s+)?\w+)?(?:\s+where\s+(?:1\s*=\s*1|true|1|\\?'1\\?'\s*=\s*\\?'1\\?'))?\s*;?\s*$</field>
    <description>Reefed: DELETE sem WHERE (apaga a tabela inteira) enviado por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>reefed_destructive,pci_dss_10.2.7,gdpr_IV_32.2,hipaa_164.312.c.1,nist_800_53_AU.14,nist_800_53_SI.7,tsc_CC6.1,tsc_CC7.2,tsc_A1.2,</group>
  </rule>

  <!-- UPDATE sem WHERE: altera todas as linhas -->
  <rule id="110404" level="7">
    <if_group>reefed_query</if_group>
    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*update\s+[\w."`\[\]]+(?:\s+(?:as\s+)?\w+)?\s+set\s+(?:(?!\bwhere\b).)*$</field>
    <description>Reefed: UPDATE sem WHERE (altera a tabela inteira) enviado por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
    <group>reefed_destructive,pci_dss_10.2.7,gdpr_IV_32.2,hipaa_164.312.c.1,nist_800_53_AU.14,nist_800_53_SI.7,tsc_CC6.1,tsc_CC7.2,tsc_PI1.4,</group>
  </rule>

  <rule id="110405" level="7">
    <if_group>reefed_query</if_group>
    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*alter\s+table\b[^;]*\bdrop\b</field>
    <description>Reefed: ALTER TABLE removendo coluna/restrição enviado por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>reefed_destructive,pci_dss_10.2.7,gdpr_IV_32.2,hipaa_164.312.c.1,nist_800_53_AU.14,tsc_CC7.2,tsc_CC8.1,</group>
  </rule>

