  <!-- Outros objetos e DDL em geral: trilha de auditoria de mudanças de estrutura -->
  <rule id="110406" level="5">
    <if_group>reefed_query</if_group>
    <field name="db.query" type="pcre2">(?i)(?:^|;)\s*(?:/\*(?!!).*?\*/\s*)*drop\s+(?:view|materialized\s+view|function|procedure|routine|sequence|index|event|type|domain|extension|tablespace|publication|subscription|server|foreign\s+table)\b</field>
    <description>Reefed: objeto do banco removido por $(dstuser) (origem $(db.client)).</description>
    <group>reefed_ddl,pci_dss_10.2.7,gdpr_IV_32.2,nist_800_53_AU.14,tsc_CC8.1,</group>
  </rule>

  <rule id="110407" level="3">
