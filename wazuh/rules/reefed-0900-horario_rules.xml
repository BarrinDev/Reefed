  </rule>

  <rule id="110907" level="13">
    <if_sid>110501, 110503, 110508</if_sid>
    <time>$REEFED_OFF_HOURS</time>
    <description>Reefed: privilégio de administrador concedido fora do horário comercial por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>reefed_privilege,pci_dss_10.2.2,pci_dss_10.2.5,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AC.2,nist_800_53_AC.6,nist_800_53_AU.14,tsc_CC6.1,tsc_CC6.3,tsc_CC7.2,</group>
  </rule>

  <rule id="110908" level="11">
    <if_sid>110602, 110603, 110610, 110611</if_sid>
    <time>$REEFED_OFF_HOURS</time>
    <description>Reefed: exportação/dump do banco fora do horário comercial por $(dstuser) (origem $(db.client)).</description>
    <mitre>
      <id>T1213</id>
    </mitre>
    <group>reefed_exfiltration,pci_dss_10.2.1,gdpr_IV_32.2,gdpr_IV_35.7.d,hipaa_164.312.b,nist_800_53_AU.14,tsc_CC6.1,tsc_CC7.2,</group>
  </rule>

</group>
