<!--
  Reefed - eventos enviados pela aplicação (IDs 110150-110199)

  O sistema que usa o banco pode avisar o Reefed sobre o que acontece do lado da
  aplicação: login na tela do sistema, exportação de relatório, troca de perfil...
  Os eventos chegam pela API do Reefed (POST /api/v1/events) ou por um arquivo JSON
  lido pelo agente, sempre neste formato:

    {"reefed": {"source": "app", "app": "loja", "event": "login_failed",
                "message": "senha incorreta", "records": 0, "role": ""},
     "srcip": "203.0.113.7", "dstuser": "ana"}

  Eventos conhecidos (campo reefed.event):
    login_success, login_failed, access_denied, permission_change, user_created,
    data_export (com reefed.records), bulk_delete (com reefed.records),
    sql_injection_blocked, config_change
  Qualquer outro evento usa o nível pedido em reefed.severity (low, medium, high, critical).
-->

<group name="reefed,reefed_app,">

  <rule id="110150" level="0">
    <decoded_as>json</decoded_as>
    <field name="reefed.source">^app$</field>
    <description>Reefed: evento da aplicação $(reefed.app).</description>
  </rule>

  <rule id="110151" level="3">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^login_success$</field>
    <description>Reefed: login no sistema $(reefed.app) (usuário $(dstuser), origem $(srcip)).</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,reefed_app_login_ok,pci_dss_10.2.5,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="110152" level="5">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^login_failed$</field>
    <description>Reefed: falha de login no sistema $(reefed.app) (usuário $(dstuser), origem $(srcip)).</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,reefed_app_login_fail,pci_dss_10.2.4,pci_dss_10.2.5,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="110153" level="10" frequency="6" timeframe="120">
    <if_matched_sid>110152</if_matched_sid>
    <same_srcip />
    <description>Reefed: força bruta na tela de login do sistema $(reefed.app) (origem $(srcip)).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,reefed_app_bruteforce,pci_dss_11.4,pci_dss_10.2.4,pci_dss_10.2.5,gdpr_IV_35.7.d,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_SI.4,nist_800_53_AU.14,nist_800_53_AC.7,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="110154" level="5">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^access_denied$</field>
    <description>Reefed: acesso negado no sistema $(reefed.app) para $(dstuser): $(reefed.message)</description>
    <group>access_denied,reefed_app_denied,</group>
  </rule>

  <rule id="110155" level="10" frequency="8" timeframe="300">
    <if_matched_sid>110154</if_matched_sid>
    <same_user />
    <description>Reefed: $(dstuser) teve muitos acessos negados no sistema $(reefed.app) (possível escalada de privilégio).</description>
    <mitre>
      <id>T1068</id>
    </mitre>
    <group>reefed_app_denied,</group>
  </rule>

  <rule id="110156" level="8">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^permission_change$</field>
    <description>Reefed: permissões de $(dstuser) alteradas no sistema $(reefed.app) (perfil $(reefed.role)).</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>reefed_app_privilege,pci_dss_10.2.5,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AC.2,tsc_CC6.2,tsc_CC6.3,</group>
  </rule>

  <rule id="110157" level="11">
    <if_sid>110156</if_sid>
    <field name="reefed.role" type="pcre2">(?i)admin|root|super|dba|gerente|owner</field>
    <description>Reefed: $(dstuser) recebeu perfil administrativo ($(reefed.role)) no sistema $(reefed.app).</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>reefed_app_privilege,pci_dss_10.2.5,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AC.2,nist_800_53_AC.6,tsc_CC6.2,tsc_CC6.3,</group>
  </rule>

  <rule id="110158" level="5">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^user_created$</field>
    <description>Reefed: usuário $(dstuser) criado no sistema $(reefed.app).</description>
    <mitre>
      <id>T1136</id>
    </mitre>
    <group>reefed_app_privilege,</group>
  </rule>

  <rule id="110159" level="3">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^data_export$</field>
    <description>Reefed: exportação de dados no sistema $(reefed.app) por $(dstuser) ($(reefed.records) registros).</description>
    <mitre>
      <id>T1213</id>
    </mitre>
    <group>reefed_app_export,</group>
  </rule>

  <rule id="110160" level="8">
    <if_sid>110159</if_sid>
    <field name="reefed.records" type="pcre2">^[1-9]\d{3,}$</field>
    <description>Reefed: exportação grande no sistema $(reefed.app) por $(dstuser) ($(reefed.records) registros).</description>
    <mitre>
      <id>T1213</id>
    </mitre>
    <group>reefed_app_export,reefed_exfiltration,</group>
  </rule>

  <rule id="110161" level="11">
    <if_sid>110160</if_sid>
    <field name="reefed.records" type="pcre2">^[1-9]\d{4,}$</field>
    <description>Reefed: exportação em massa no sistema $(reefed.app) por $(dstuser) ($(reefed.records) registros).</description>
    <mitre>
      <id>T1213</id>
      <id>T1030</id>
    </mitre>
    <group>reefed_app_export,reefed_exfiltration,pci_dss_10.2.1,gdpr_IV_32.2,hipaa_164.312.b,nist_800_53_AU.14,tsc_CC6.1,</group>
  </rule>

  <rule id="110162" level="7">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^bulk_delete$</field>
    <description>Reefed: exclusão em lote no sistema $(reefed.app) por $(dstuser) ($(reefed.records) registros).</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>reefed_app_delete,</group>
  </rule>

  <rule id="110163" level="11">
    <if_sid>110162</if_sid>
    <field name="reefed.records" type="pcre2">^[1-9]\d{2,}$</field>
    <description>Reefed: exclusão em massa no sistema $(reefed.app) por $(dstuser) ($(reefed.records) registros).</description>
    <mitre>
      <id>T1485</id>
    </mitre>
    <group>reefed_app_delete,reefed_destructive,</group>
  </rule>

  <rule id="110164" level="12">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^sql_injection_blocked$</field>
    <description>Reefed: a aplicação $(reefed.app) bloqueou uma tentativa de SQL injection (origem $(srcip)).</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>reefed_app_sqli,reefed_sqli,attack,pci_dss_6.5,pci_dss_11.4,pci_dss_6.5.1,gdpr_IV_35.7.d,nist_800_53_SA.11,nist_800_53_SI.4,tsc_CC6.6,tsc_CC7.1,tsc_CC8.1,tsc_CC6.1,tsc_CC6.8,tsc_CC7.2,tsc_CC7.3,</group>
  </rule>

  <rule id="110165" level="7">
    <if_sid>110150</if_sid>
    <field name="reefed.event">^config_change$</field>
    <description>Reefed: configuração do sistema $(reefed.app) alterada por $(dstuser): $(reefed.message)</description>
    <group>reefed_app_config,</group>
  </rule>

  <!-- Eventos livres: o nível vem de reefed.severity -->
  <rule id="110170" level="12">
    <if_sid>110150</if_sid>
    <field name="reefed.event" type="pcre2" negate="yes">^(?:login_success|login_failed|access_denied|permission_change|user_created|data_export|bulk_delete|sql_injection_blocked|config_change)$</field>
    <field name="reefed.severity" type="pcre2">(?i)^(?:critical|critica|crítica)$</field>
    <description>Reefed: evento crítico no sistema $(reefed.app): $(reefed.event) $(reefed.message)</description>
    <group>reefed_app_custom,</group>
  </rule>

  <rule id="110171" level="10">
    <if_sid>110150</if_sid>
    <field name="reefed.event" type="pcre2" negate="yes">^(?:login_success|login_failed|access_denied|permission_change|user_created|data_export|bulk_delete|sql_injection_blocked|config_change)$</field>
    <field name="reefed.severity" type="pcre2">(?i)^(?:high|alta)$</field>
    <description>Reefed: evento de severidade alta no sistema $(reefed.app): $(reefed.event) $(reefed.message)</description>
    <group>reefed_app_custom,</group>
  </rule>

  <rule id="110172" level="7">
    <if_sid>110150</if_sid>
    <field name="reefed.event" type="pcre2" negate="yes">^(?:login_success|login_failed|access_denied|permission_change|user_created|data_export|bulk_delete|sql_injection_blocked|config_change)$</field>
    <field name="reefed.severity" type="pcre2">(?i)^(?:medium|media|média)$</field>
    <description>Reefed: evento de severidade média no sistema $(reefed.app): $(reefed.event) $(reefed.message)</description>
    <group>reefed_app_custom,</group>
  </rule>

  <rule id="110173" level="3">
    <if_sid>110150</if_sid>
    <field name="reefed.event" type="pcre2" negate="yes">^(?:login_success|login_failed|access_denied|permission_change|user_created|data_export|bulk_delete|sql_injection_blocked|config_change)$</field>
    <description>Reefed: evento $(reefed.event) no sistema $(reefed.app): $(reefed.message)</description>
    <group>reefed_app_custom,</group>
  </rule>

</group>
